{
  "name": "hamomap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "https://hamod1hamod.github.io/hamomap/",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "gh-pages -d dist",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:build": "npm run build && npx electron-packager . MindForge-AI --out=release --overwrite --platform=linux,win32 --arch=x64 --ignore=\"^/(src|tests|functions|\\.git)\"",
    "desktop:build:linux": "npm run build && npx electron-packager . MindForge-AI --out=release --overwrite --platform=linux --arch=x64 --ignore=\"^/(src|tests|functions|\\.git)\"",
    "desktop:build:win": "npm run build && npx electron-packager . MindForge-AI --out=release --overwrite --platform=win32 --arch=x64 --ignore=\"^/(src|tests|functions|\\.git)\""
  },
  "dependencies": {
    "@xyflow/react": "^12.3.1",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "firebase": "^10.13.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "@noble/hashes": "2.3.0"
  }
}
